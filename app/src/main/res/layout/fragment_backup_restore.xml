<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💾 Copia de Seguridad y Restauración"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#2C3E50" />

    <Button
        android:id="@+id/btnCreateBackup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#10B981"
        android:text="💾 Crear Copia de Seguridad"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnRestore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2563EB"
        android:text="📂 Restaurar Datos"
        android:textColor="#FFFFFF" />

    <ProgressBar
        android:id="@+id/progressBarBackup"
        style="?attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBackupStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:text="✅ Sistema listo para copias de seguridad"
        android:textColor="#8C9BA5"
        android:textSize="14sp" />
</LinearLayout>
