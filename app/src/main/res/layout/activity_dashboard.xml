<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- Cabecera del Sistema -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="King System Core [v1.0.9]"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema Activo • Red de Datos Móviles"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <!-- Botón de Control Principal del Núcleo -->
    <Button
        android:id="@+id/btnToggleBot"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="INICIAR NÚCLEO BOT"
        android:textColor="#FFFFFF"
        android:backgroundTint="#38BDF8"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Panel de Gráficas y Estadísticas Profesionales -->
    <com.app.bot.StatisticsView
        android:id="@+id/statisticsView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp" />

    <!-- Botones de Utilidades y Herramientas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <ImageView
            android:id="@+id/btnCheckBuildStatus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Build Status" />

        <ImageView
            android:id="@+id/btnOpenUpdateModal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_upload"
            android:contentDescription="Update" />

        <ImageView
            android:id="@+id/btnOpenCommits"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_recent_history"
            android:contentDescription="History" />

        <ImageView
            android:id="@+id/btnOpenNotifications"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="Notifications" />
    </LinearLayout>

</LinearLayout>
