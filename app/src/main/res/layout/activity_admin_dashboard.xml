<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="InDrive Bot Panel"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCheckUpdate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_upload"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Actualizar" />
    </LinearLayout>

    <!-- Tarjeta de Estado del Sistema -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTADO DEL SERVICIO"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inactivo (Listo para iniciar)"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Área de Información / Consola Interna -->
    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#181818"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:padding="12dp"
        android:text="[Sistema] Aplicación lista y optimizada.\n[Sistema] Esperando comandos internos...\n"
        android:scrollbars="vertical"
        android:layout_marginBottom="24dp" />

    <!-- Botón de Control Principal -->
    <Button
        android:id="@+id/btnToggleBot"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="INICIAR BOT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#00E676" />

</LinearLayout>
